# NANOREM MLM System - Environment Variables Example
# Copy this file to .env and fill in your actual values

# ====================================
# TELEGRAM BOT CONFIGURATION
# ====================================
# Get your token from BotFather in Telegram
BOT_TOKEN=your_bot_token_here

# ====================================
# DATABASE CONFIGURATION
# ====================================
# SQLite (default for development)
DATABASE_URL=sqlite:///nanorem.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/nanorem

# ====================================
# APPLICATION SETTINGS
# ====================================
APP_NAME=NANOREM MLM System
APP_VERSION=0.1.0

# Debug mode: true / false
DEBUG=false

# Logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ====================================
# WEBHOOK / ADMIN SECURITY
# ====================================
# Set WEBHOOK_URL to the public base URL (without a path) for Telegram webhook mode.
# Leave blank when running the bot in polling mode.
# WEBHOOK_URL=https://yourdomain.com
# WEBHOOK_PORT=8443

# Required for WooCommerce order webhooks.
WOOCOMMERCE_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Required for Telegram webhook mode when WEBHOOK_URL is set.
# TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Optional. Technical/admin routes are enabled only when DEBUG=true and this is set.
# ADMIN_API_SECRET=replace_with_a_long_random_secret

# ====================================
# WOOCOMMERCE REST API (optional)
# ====================================
# WC_API_BASE_URL=https://yourdomain.com/wp-json/wc/v3
# WC_CONSUMER_KEY=your_consumer_key
# WC_CONSUMER_SECRET=your_consumer_secret

# ====================================
# SMTP AUTHENTICATION CODE DELIVERY
# ====================================
SMTP_ENABLED=false
SMTP_HOST=mail.nanorvs.ru
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=NANOREM
SMTP_TIMEOUT=15
